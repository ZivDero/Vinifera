<rml>
<head>
    <link type="text/rcss" href="/RMLUI/COMMON.RCSS"/>
</head>
<body>
<div id="shade"></div>
<div class="dialog d292x157">
    <div class="label right" style="left:44px;top:24px;width:126px;height:30px;">Game Speed:</div>
    <div id="game_speed" class="slider" style="left:180px;top:24px;width:256px;height:30px;"><button id="game_speed_dec" class="slider-button slider-dec">-</button><div id="game_speed_track" class="slider-track" style="width:200px;"></div><div id="game_speed_fill" class="slider-fill"></div><div id="game_speed_thumb" class="slider-thumb"></div><button id="game_speed_inc" class="slider-button slider-inc">+</button></div>
    <div id="game_speed_label" class="label" style="left:448px;top:24px;width:100px;height:30px;"></div>
    <div class="label right" style="left:44px;top:86px;width:126px;height:30px;">Scroll Rate:</div>
    <div id="scroll_speed" class="slider" style="left:180px;top:86px;width:256px;height:30px;"><button id="scroll_speed_dec" class="slider-button slider-dec">-</button><div id="scroll_speed_track" class="slider-track" style="width:200px;"></div><div id="scroll_speed_fill" class="slider-fill"></div><div id="scroll_speed_thumb" class="slider-thumb"></div><button id="scroll_speed_inc" class="slider-button slider-inc">+</button></div>
    <div id="scroll_speed_label" class="label" style="left:448px;top:86px;width:100px;height:30px;"></div>
    <div class="label right" style="left:44px;top:148px;width:126px;height:30px;">Visual Details:</div>
    <div id="detail_level" class="slider" style="left:180px;top:148px;width:256px;height:30px;"><button id="detail_level_dec" class="slider-button slider-dec">-</button><div id="detail_level_track" class="slider-track" style="width:200px;"></div><div id="detail_level_fill" class="slider-fill"></div><div id="detail_level_thumb" class="slider-thumb"></div><button id="detail_level_inc" class="slider-button slider-inc">+</button></div>
    <div id="detail_label" class="label" style="left:448px;top:148px;width:100px;height:30px;"></div>
    <button id="cameo_text" class="checkbox" style="left:44px;top:188px;width:216px;height:20px;"></button>
    <button id="action_lines" class="checkbox" style="left:44px;top:224px;width:216px;height:20px;"></button>
    <button id="tooltips" class="checkbox" style="left:294px;top:188px;width:232px;height:20px;"></button>
    <button id="scroll_coasting" class="checkbox" style="left:294px;top:224px;width:232px;height:20px;"></button>
    <button id="sound" style="left:44px;top:262px;width:154px;height:28px;">Sound</button>
    <button id="keyboard" style="left:218px;top:262px;width:154px;height:28px;">Keyboard</button>
    <button id="ok" style="left:392px;top:262px;width:154px;height:28px;">Options Menu</button>
</div>
</body>
</rml>
