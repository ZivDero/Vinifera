<rml>
<head>
    <link type="text/rcss" href="/RMLUI/COMMON.RCSS"/>
</head>
<body>
<div id="shade"></div>
<div class="dialog d209x140">
    <button id="settings" style="left:94px;top:24px;width:230px;height:28px;">Game Controls</button>
    <button id="restate" style="left:94px;top:58px;width:230px;height:28px;">Restate Briefing</button>
    <button id="load" style="left:94px;top:92px;width:230px;height:28px;">Load Game</button>
    <button id="save" style="left:94px;top:126px;width:230px;height:28px;">Save Game</button>
    <button id="delete" style="left:94px;top:160px;width:230px;height:28px;">Delete Game</button>
    <button id="abort" style="left:94px;top:194px;width:230px;height:28px;">Abort Mission</button>
    <button id="resume" style="left:94px;top:228px;width:230px;height:28px;">Resume Mission</button>
</div>
</body>
