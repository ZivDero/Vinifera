<rml>
<head>
    <link type="text/rcss" href="/RMLUI/COMMON.RCSS"/>
</head>
<body>
<div id="shade"></div>
<div class="dialog d294x215">
    <div class="label right" style="left:44px;top:24px;width:140px;height:30px;">Music Volume:</div>
    <div id="music_volume" class="slider" style="left:194px;top:24px;width:350px;height:30px;"><button id="music_volume_dec" class="slider-button slider-dec">-</button><div id="music_volume_track" class="slider-track" style="width:294px;"></div><div id="music_volume_fill" class="slider-fill"></div><div id="music_volume_thumb" class="slider-thumb"></div><button id="music_volume_inc" class="slider-button slider-inc">+</button></div>
    <div class="label right" style="left:44px;top:68px;width:140px;height:30px;">Sound Volume:</div>
    <div id="sound_volume" class="slider" style="left:194px;top:68px;width:350px;height:30px;"><button id="sound_volume_dec" class="slider-button slider-dec">-</button><div id="sound_volume_track" class="slider-track" style="width:294px;"></div><div id="sound_volume_fill" class="slider-fill"></div><div id="sound_volume_thumb" class="slider-thumb"></div><button id="sound_volume_inc" class="slider-button slider-inc">+</button></div>
    <div class="label right" style="left:44px;top:112px;width:140px;height:30px;">Voice Volume:</div>
    <div id="voice_volume" class="slider" style="left:194px;top:112px;width:350px;height:30px;"><button id="voice_volume_dec" class="slider-button slider-dec">-</button><div id="voice_volume_track" class="slider-track" style="width:294px;"></div><div id="voice_volume_fill" class="slider-fill"></div><div id="voice_volume_thumb" class="slider-thumb"></div><button id="voice_volume_inc" class="slider-button slider-inc">+</button></div>
    <button id="play" style="left:44px;top:172px;width:140px;height:28px;">Play</button>
    <button id="stop" style="left:44px;top:226px;width:140px;height:28px;">Stop</button>
    <button id="shuffle" class="checkbox" style="left:44px;top:280px;width:118px;height:28px;"></button>
    <button id="repeat" class="checkbox" style="left:44px;top:334px;width:118px;height:28px;"></button>
    <div id="theme_list" class="listbox" style="left:194px;top:164px;width:350px;height:198px;"></div>
    <button id="ok" style="left:420px;top:378px;width:124px;height:28px;">OK</button>
</div>
</body>
</rml>
