<rml>
<head>
    <link type="text/rcss" href="/RMLUI/COMMON.RCSS"/>
</head>
<body>
<div id="shade"></div>
<div class="dialog d294x126">
    <div class="label right" style="left:44px;top:24px;width:126px;height:30px;">Scroll Rate:</div>
    <input type="range" id="scroll_speed" min="0" max="6" value="0" style="left:180px;top:24px;width:256px;height:30px;"/>
    <div id="scroll_speed_label" class="label" style="left:452px;top:24px;width:100px;height:30px;"></div>
    <div class="label right" style="left:44px;top:86px;width:126px;height:30px;">Visual Details:</div>
    <input type="range" id="detail_level" min="0" max="2" value="0" style="left:180px;top:86px;width:256px;height:30px;"/>
    <div id="detail_label" class="label" style="left:452px;top:86px;width:100px;height:30px;"></div>
    <input type="checkbox" id="cameo_text" style="left:44px;top:126px;"/><label for="cameo_text" class="checklabel" style="left:66px;top:126px;width:216px;height:20px;">Sidebar Text</label>
    <input type="checkbox" id="action_lines" style="left:44px;top:162px;"/><label for="action_lines" class="checklabel" style="left:66px;top:162px;width:216px;height:20px;">Target Lines</label>
    <input type="checkbox" id="tooltips" style="left:294px;top:126px;"/><label for="tooltips" class="checklabel" style="left:316px;top:126px;width:232px;height:20px;">Tooltips</label>
    <input type="checkbox" id="scroll_coasting" style="left:294px;top:162px;"/><label for="scroll_coasting" class="checklabel" style="left:316px;top:162px;width:232px;height:20px;">Scroll Coasting</label>
    <button id="sound" style="left:44px;top:200px;width:154px;height:28px;">Sound</button>
    <button id="keyboard" style="left:218px;top:200px;width:154px;height:28px;">Keyboard</button>
    <button id="ok" style="left:392px;top:200px;width:154px;height:28px;">Options Menu</button>
</div>
</body>
</rml>
