<rml>
<head>
    <link type="text/rcss" href="/RMLUI/COMMON.RCSS"/>
</head>
<body>
<div id="shade"></div>
<div class="dialog d292x163">
    <div class="label" style="left:44px;top:24px;width:116px;height:26px;">Game Speed</div>
    <input type="range" id="game_speed" min="0" max="6" value="0" style="left:160px;top:24px;width:296px;height:26px;"/>
    <div id="game_speed_label" class="label right" style="left:458px;top:24px;width:90px;height:26px;"></div>
    <div class="label" style="left:44px;top:68px;width:116px;height:26px;">Scroll Rate</div>
    <input type="range" id="scroll_speed" min="0" max="6" value="0" style="left:160px;top:68px;width:296px;height:26px;"/>
    <div id="scroll_speed_label" class="label right" style="left:458px;top:68px;width:90px;height:26px;"></div>
    <div class="label" style="left:44px;top:112px;width:116px;height:26px;">Visual Details</div>
    <input type="range" id="detail_level" min="0" max="2" value="0" style="left:160px;top:112px;width:296px;height:26px;"/>
    <div id="detail_label" class="label right" style="left:458px;top:112px;width:90px;height:26px;"></div>
    <div class="label" style="left:44px;top:156px;width:116px;height:26px;">Difficulty</div>
    <input type="range" id="difficulty" min="0" max="2" value="0" style="left:160px;top:156px;width:296px;height:26px;"/>
    <div id="difficulty_label" class="label right" style="left:458px;top:156px;width:90px;height:26px;"></div>
    <input type="checkbox" id="cameo_text" style="left:44px;top:206px;"/><label for="cameo_text" class="checklabel" style="left:66px;top:206px;width:226px;height:20px;">Cameo Text</label>
    <input type="checkbox" id="action_lines" style="left:44px;top:238px;"/><label for="action_lines" class="checklabel" style="left:66px;top:238px;width:226px;height:20px;">Target Lines</label>
    <input type="checkbox" id="tooltips" style="left:292px;top:206px;"/><label for="tooltips" class="checklabel" style="left:314px;top:206px;width:234px;height:20px;">Tooltips</label>
    <input type="checkbox" id="scroll_coasting" style="left:292px;top:238px;"/><label for="scroll_coasting" class="checklabel" style="left:314px;top:238px;width:234px;height:20px;">Scroll Coasting</label>
    <button id="ok" style="left:162px;top:274px;width:260px;height:28px;">Main Menu</button>
</div>
</body>
</rml>
