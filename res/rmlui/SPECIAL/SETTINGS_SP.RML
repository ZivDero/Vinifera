<rml>
<head>
    <link type="text/rcss" href="/RMLUI/COMMON.RCSS"/>
</head>
<body>
<div id="shade"></div>
<div class="dialog d292x163">
    <div class="label" style="left:44px;top:24px;width:116px;height:26px;">Game Speed</div>
    <div id="game_speed" class="slider" style="left:160px;top:24px;width:296px;height:30px;"><button id="game_speed_dec" class="slider-button slider-dec">-</button><div id="game_speed_track" class="slider-track" style="width:240px;"></div><div id="game_speed_fill" class="slider-fill"></div><div id="game_speed_thumb" class="slider-thumb"></div><button id="game_speed_inc" class="slider-button slider-inc">+</button></div>
    <div id="game_speed_label" class="label right" style="left:458px;top:24px;width:90px;height:26px;"></div>
    <div class="label" style="left:44px;top:68px;width:116px;height:26px;">Scroll Rate</div>
    <div id="scroll_speed" class="slider" style="left:160px;top:68px;width:296px;height:30px;"><button id="scroll_speed_dec" class="slider-button slider-dec">-</button><div id="scroll_speed_track" class="slider-track" style="width:240px;"></div><div id="scroll_speed_fill" class="slider-fill"></div><div id="scroll_speed_thumb" class="slider-thumb"></div><button id="scroll_speed_inc" class="slider-button slider-inc">+</button></div>
    <div id="scroll_speed_label" class="label right" style="left:458px;top:68px;width:90px;height:26px;"></div>
    <div class="label" style="left:44px;top:112px;width:116px;height:26px;">Visual Details</div>
    <div id="detail_level" class="slider" style="left:160px;top:112px;width:296px;height:30px;"><button id="detail_level_dec" class="slider-button slider-dec">-</button><div id="detail_level_track" class="slider-track" style="width:240px;"></div><div id="detail_level_fill" class="slider-fill"></div><div id="detail_level_thumb" class="slider-thumb"></div><button id="detail_level_inc" class="slider-button slider-inc">+</button></div>
    <div id="detail_label" class="label right" style="left:458px;top:112px;width:90px;height:26px;"></div>
    <div class="label" style="left:44px;top:156px;width:116px;height:26px;">Difficulty</div>
    <div id="difficulty" class="slider" style="left:160px;top:156px;width:296px;height:30px;"><button id="difficulty_dec" class="slider-button slider-dec">-</button><div id="difficulty_track" class="slider-track" style="width:240px;"></div><div id="difficulty_fill" class="slider-fill"></div><div id="difficulty_thumb" class="slider-thumb"></div><button id="difficulty_inc" class="slider-button slider-inc">+</button></div>
    <div id="difficulty_label" class="label right" style="left:458px;top:156px;width:90px;height:26px;"></div>
    <button id="cameo_text" class="checkbox" style="left:44px;top:206px;width:226px;height:20px;"></button>
    <button id="action_lines" class="checkbox" style="left:44px;top:238px;width:226px;height:20px;"></button>
    <button id="tooltips" class="checkbox" style="left:292px;top:206px;width:234px;height:20px;"></button>
    <button id="scroll_coasting" class="checkbox" style="left:292px;top:238px;width:234px;height:20px;"></button>
    <button id="ok" style="left:162px;top:274px;width:260px;height:28px;">Main Menu</button>
</div>
</body>
</rml>
